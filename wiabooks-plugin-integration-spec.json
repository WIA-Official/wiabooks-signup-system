  "integration_patterns": {
    "cross_plugin_communication": {
      "detection_method": {
        "description": "Social Login plugin detects WIABooks via class existence",
        "code": "class_exists('WIABooks_Signup_System')",
        "location": "WIA_Social_Auth_Handler::is_wiabooks_active()"
      },

      "shared_user_flow": {
        "new_user_via_google": [
          "1. User clicks Google login (Nextend Social Login)",
          "2. WIABooks_Signup_Handler::handle_social_login triggered (nsl_login hook)",
          "3. Check wiabooks_book_category_id metadata",
          "4. Redirect to /book-info/ (no category) or /author-dashboard/ (has category)"
        ],
        "new_user_via_kakao_naver": [
          "1. User clicks Kakao/Naver button",
          "2. OAuth flow completes at callback URL",
          "3. WIA_Social_Auth_Handler::create_user creates WordPress user",
          "4. If WIABooks active: Initialize wiabooks_credit=1000, wiabooks_signup_date",
          "5. WIA_Social_Auth_Handler::get_redirect_url checks wiabooks_book_category_id",
          "6. Redirect to /book-info/ (new) or /author-dashboard/ (existing)"
        ],
        "book_info_submission": [
          "1. User submits book info at /book-info/",
          "2. AJAX to submit_book_info endpoint",
          "3. WIABooks_Category_Manager creates category with romanized slug",
          "4. Set user metadata: wiabooks_book_category_id, wiabooks_book_title, wiabooks_credit=1000",
          "5. Set user role to 'author'",
          "6. Redirect to /author-dashboard/"
        ]
      },

      "shared_metadata": [
        {
          "meta_key": "wiabooks_credit",
          "initialized_by": [
            "WIABooks plugin activation (set_default_credits)",
            "WIABooks book info submission",
            "Social Login user creation (if WIABooks active)"
          ],
          "default_value": 1000
        },
        {
          "meta_key": "wiabooks_signup_date",
          "initialized_by": [
            "WIABooks book info submission",
            "Social Login user creation (if WIABooks active)"
          ],
          "format": "mysql datetime"
        },
        {
          "meta_key": "wiabooks_book_category_id",
          "initialized_by": "WIABooks book info submission only",
          "critical": true,
          "usage": "Determines redirect logic, permission filtering, post assignment"
        }
      ]
    },

    "common_user_journeys": {
      "journey_1_google_new_author": {
        "steps": [
          "1. Visit WordPress login page",
          "2. Click Google login (Nextend)",
          "3. Authenticate with Google",
          "4. Redirect to /book-info/",
          "5. Enter book title, subtitle, description",
          "6. Submit form (AJAX)",
          "7. Category created with romanized slug",
          "8. User metadata set (category_id, title, credit=1000, role=author)",
          "9. Redirect to /author-dashboard/",
          "10. Create posts (auto-assigned to category, collaboration with same-category authors)"
        ]
      },
      "journey_2_kakao_new_author": {
        "steps": [
          "1. Visit WordPress login page",
          "2. Click Kakao login button",
          "3. Authenticate with Kakao",
          "4. Callback to /kakao-callback/",
          "5. User created with wiabooks_credit=1000 (if WIABooks active)",
          "6. Redirect to /book-info/",
          "7. [Same as journey_1 from step 5]"
        ]
      },
      "journey_3_existing_author_login": {
        "steps": [
          "1. Login via Google/Kakao/Naver",
          "2. Detect wiabooks_book_category_id exists",
          "3. Direct redirect to /author-dashboard/",
          "4. View stats, writing progress, recent posts",
          "5. Create/edit posts in own category"
        ]
      }
    }
  },

  "technical_requirements": {
    "wordpress": {
      "min_version": "6.0",
      "tested_up_to": "6.4"
    },
    "php": {
      "min_version": "7.4",
      "recommended": "8.0+"
    },
    "server": {
      "https": "Required for OAuth callbacks",
      "extensions": ["json", "curl", "mbstring"]
    },
    "external_apis": {
      "kakao": {
        "developer_url": "https://developers.kakao.com/",
        "required_credentials": ["REST API Key"],
        "optional_credentials": ["Client Secret"],
        "required_scopes": ["account_email (required)", "profile (optional)"],
        "callback_url_format": "https://yourdomain.com/kakao-callback/"
      },
      "naver": {
        "developer_url": "https://developers.naver.com/",
        "required_credentials": ["Client ID", "Client Secret"],
        "required_scopes": ["email (required)", "name (required)", "profile_image (optional)"],
        "callback_url_format": "https://yourdomain.com/naver-callback/"
      },
      "google": {
        "handled_by": "Nextend Social Login plugin",
        "note": "WIABooks integrates via nsl_login hook"
      }
    }
  },

  "deployment_notes": {
    "installation_order": [
      "1. Install and configure Nextend Social Login (Google)",
      "2. Install and activate WIABooks Signup System",
      "3. Install and activate WIA Books Social Login",
      "4. Configure Kakao/Naver API keys",
      "5. Flush permalinks (Settings > Permalinks > Save)"
    ],
    "permalink_structure": {
      "required": "Pretty permalinks enabled",
      "custom_routes": [
        "/book-info/",
        "/author-dashboard/",
        "/kakao-callback/",
        "/naver-callback/"
      ]
    },
    "critical_config": {
      "kakao_redirect_uri": "Must match exactly in Kakao Developer Console",
      "naver_redirect_uri": "Must match exactly in Naver Developer Console",
      "https": "Required for OAuth 2.0 security"
    }
  },

  "extension_points": {
    "custom_hooks": [
      {
        "hook": "wiabooks_signup_loaded",
        "type": "action",
        "args": 0,
        "description": "Triggered after WIABooks plugin initialization",
        "use_case": "Add custom functionality to WIABooks system"
      },
      {
        "hook": "wia_social_login_loaded",
        "type": "action",
        "args": 0,
        "description": "Triggered after Social Login plugin initialization",
        "use_case": "Add custom social providers or modify behavior"
      },
      {
        "hook": "wia_social_login_user_created",
        "type": "action",
        "args": 3,
        "parameters": ["user_id", "user_info", "provider"],
        "description": "Triggered after new user created via social login",
        "use_case": "Initialize custom user data, send welcome email, etc."
      }
    ],

    "filter_hooks": [
      {
        "hook": "Potential: wiabooks_redirect_after_book_info",
        "current_value": "home_url('/author-dashboard/')",
        "use_case": "Customize redirect destination after book info submission"
      },
      {
        "hook": "Potential: wia_social_login_redirect_url",
        "current_value": "Calculated by WIA_Social_Auth_Handler::get_redirect_url",
        "use_case": "Override redirect logic for specific use cases"
      }
    ]
  },

  "known_issues_and_fixes": {
    "fixed_issues": [
      {
        "date": "2025-11-23",
        "issue": "Authors couldn't access post-new.php - 403 errors in block editor",
        "root_cause": "WIABooks_Permission_Manager::check_post_edit_permission too restrictive",
        "symptom": "REST API requests blocked by permission check",
        "fix": "Added REST_REQUEST, DOING_AJAX, DOING_AUTOSAVE exceptions",
        "file": "includes/class-permission-manager.php",
        "lines": "145-158",
        "commit": "a241e3d - Fix: Author 권한 시스템 버그 수정"
      }
    ],
    "potential_considerations": [
      {
        "area": "Category deletion",
        "consideration": "Categories with posts cannot be deleted - ensure proper cleanup flow"
      },
      {
        "area": "Multi-author collaboration",
        "consideration": "Same-category authors can edit each other's posts - document this behavior"
      },
      {
        "area": "Email conflicts",
        "consideration": "Social login with existing email links accounts - clear user communication needed"
      }
    ]
  },

