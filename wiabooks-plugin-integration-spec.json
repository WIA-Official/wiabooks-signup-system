      },

      "main_class": {
        "name": "WIABooks_Signup_System",
        "instance_method": "WIABooks_Signup_System::instance()",
        "global_function": "WIABooks()",
        "singleton": true
      },

      "core_classes": [
        {
          "name": "WIABooks_Signup_Handler",
          "file": "includes/class-signup-handler.php",
          "responsibilities": [
            "Handle social login redirection flow",
            "Manage book information submission",
            "Provide custom pages via rewrite rules",
            "AJAX form processing"
          ],
          "key_methods": {
            "handle_social_login": {
              "description": "Redirect users after Google login - new users to /book-info/, existing to /author-dashboard/",
              "hook": "nsl_login",
              "priority": 10,
              "args": 1,
              "logic": "Check for wiabooks_book_category_id user meta to determine redirect"
            },
            "handle_book_info_submission": {
              "description": "Process book information form via AJAX",
              "ajax_action": "submit_book_info",
              "nonce": "wiabooks_book_info",
              "creates": "Category, user metadata, sets author role, assigns $1,000 credit"
            }
          }
        },
        {
          "name": "WIABooks_Category_Manager",
          "file": "includes/class-category-manager.php",
          "responsibilities": [
            "Create WordPress categories from Korean book titles",
            "Romanize Korean text to English slugs",
            "Manage category lifecycle"
          ],
          "key_methods": {
            "create_book_category": {
              "description": "Create category with Korean title and romanized slug",
              "params": ["book_title (Korean)", "description (optional)"],
              "returns": "category_id or WP_Error",
              "algorithm": "Uses Revised Romanization of Korean (초성/중성/종성 decomposition)"
            },
            "romanize_korean": {
              "description": "Convert Korean text to romanized English slug",
              "example": "나의 첫 소설 → naui-cheot-soseol",
              "unicode_range": "0xAC00 to 0xD7A3 (Hangul syllables)"
            }
          },
          "romanization_map": {
            "cho": ["g", "kk", "n", "d", "tt", "r", "m", "b", "pp", "s", "ss", "", "j", "jj", "ch", "k", "t", "p", "h"],
            "jung": ["a", "ae", "ya", "yae", "eo", "e", "yeo", "ye", "o", "wa", "wae", "oe", "yo", "u", "wo", "we", "wi", "yu", "eu", "ui", "i"],
            "jong": ["", "k", "k", "k", "n", "n", "n", "l", "l", "l", "l", "l", "l", "l", "l", "m", "p", "p", "t", "t", "ng", "t", "t", "k", "t", "p", "t"]
          }
        },
        {
          "name": "WIABooks_Permission_Manager",
          "file": "includes/class-permission-manager.php",
          "responsibilities": [
            "Category-based permission system for authors",
            "Filter posts by category in admin",
            "Restrict editing to own posts and same-category posts",
            "Auto-assign categories to posts"
          ],
          "key_methods": {
            "check_post_edit_permission": {
              "description": "Core permission logic - controls who can edit/delete posts",
              "filter": "user_has_cap",
              "priority": 10,
              "args": 4,
              "permission_rules": {
                "rule_0": "Administrators bypass all checks (manage_options capability)",
                "rule_1": "Allow REST_REQUEST, DOING_AJAX, DOING_AUTOSAVE (WordPress block editor compatibility)",
                "rule_2": "Allow new post creation (no post_id)",
                "rule_3": "Allow editing own posts (post_author === user_id)",
                "rule_4": "Allow editing posts in same category (collaboration feature)",
                "rule_5": "Deny editing posts in different categories"
              },
              "critical_fix": "Added REST API exception to fix 403 errors in block editor (2025-11-23)"
            },
            "filter_posts_by_category": {
              "description": "Restrict admin post list to user's category only",
              "filter": "pre_get_posts",
              "logic": "Set 'cat' query var to wiabooks_book_category_id"
            },
            "auto_assign_category": {
              "description": "Automatically assign user's category when creating/updating posts",
              "action": "save_post",
              "priority": 10,
              "args": 3
            }
          }
        },
        {
          "name": "WIABooks_Admin_Dashboard",
          "file": "includes/class-admin-dashboard.php",
          "responsibilities": [
            "Admin menu for managing authors",
            "User statistics and credit management",
            "Author list interface"
          ]
        }
      ],

      "wordpress_routes": {
        "custom_pages": [
          {
            "url": "/book-info/",
