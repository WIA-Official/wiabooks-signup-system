      "description": "Core WIABooks member management system with Google login (Nextend), automatic category creation, permission management, and author dashboards",

      "constants": {
        "WIABOOKS_VERSION": "1.0.0",
        "WIABOOKS_PLUGIN_DIR": "plugin_dir_path(__FILE__)",
        "WIABOOKS_PLUGIN_URL": "plugin_dir_url(__FILE__)",
