    {
      "name": "WIA Books Social Login",
      "slug": "wia-books-social-login",
      "version": "1.0.0",
      "repository": "https://github.com/WIA-Official/wia-books-social-login",
      "main_file": "wia-books-social-login.php",
      "text_domain": "wia-social-login",
      "description": "Kakao and Naver OAuth 2.0 social login integration with WIABooks system auto-detection and integration",

      "constants": {
        "WIA_SOCIAL_LOGIN_VERSION": "1.0.0",
        "WIA_SOCIAL_LOGIN_PLUGIN_DIR": "plugin_dir_path(__FILE__)",
        "WIA_SOCIAL_LOGIN_PLUGIN_URL": "plugin_dir_url(__FILE__)",
        "WIA_SOCIAL_LOGIN_PLUGIN_BASENAME": "plugin_basename(__FILE__)"
      },

      "main_class": {
        "name": "WIA_Social_Login",
        "instance_method": "WIA_Social_Login::instance()",
        "global_function": "WIA_Social_Login()",
        "singleton": true
      },

      "core_classes": [
        {
          "name": "WIA_Social_Auth_Handler",
          "file": "includes/class-social-auth-handler.php",
          "responsibilities": [
            "Unified social login processing",
            "User creation and profile synchronization",
            "WIABooks plugin integration detection",
            "Redirect logic based on user status"
          ],
          "key_methods": {
            "process_social_login": {
              "description": "Process login from Kakao or Naver",
              "params": ["user_info (array)", "provider (string: kakao|naver)"],
              "returns": "user_id or WP_Error",
              "flow": [
                "1. Find user by social ID",
                "2. If exists, sync profile and return user_id",
                "3. Check for existing email",
                "4. If email exists, link social account",
                "5. If new user, create account (if auto_create_account enabled)",
                "6. Initialize WIABooks metadata if plugin active"
              ]
            },
            "create_user": {
              "description": "Create new WordPress user from social data",
              "username_format": "{provider}_{provider_id}",
              "default_role": "author",
              "password": "wp_generate_password(20, true, true)",
              "wiabooks_init": {
                "wiabooks_credit": 1000,
                "wiabooks_signup_date": "current_time('mysql')"
              }
            },
            "get_redirect_url": {
              "description": "Intelligent redirect after login",
              "logic": {
                "wiabooks_active": {
                  "no_book": "/book-info/",
                  "has_book": "/author-dashboard/"
                },
                "wiabooks_inactive": {
                  "dashboard": "admin_url()",
                  "home": "home_url()",
                  "book-info": "/book-info/"
                }
              },
              "detection_method": "class_exists('WIABooks_Signup_System')"
            },
            "is_wiabooks_active": {
              "description": "Detect if WIABooks Signup System plugin is active",
              "method": "class_exists('WIABooks_Signup_System')",
              "return": "boolean"
            }
          }
        },
        {
          "name": "WIA_Kakao_Login",
          "file": "includes/class-kakao-login.php",
          "responsibilities": [
            "Kakao OAuth 2.0 flow implementation",
            "Authorization code exchange",
            "User info retrieval"
          ],
          "oauth_endpoints": {
            "AUTH_URL": "https://kauth.kakao.com/oauth/authorize",
            "TOKEN_URL": "https://kauth.kakao.com/oauth/token",
            "USER_INFO_URL": "https://kapi.kakao.com/v2/user/me"
          },
          "api_flow": {
            "1_authorization": {
              "url": "AUTH_URL",
              "params": {
                "client_id": "REST API Key",
                "redirect_uri": "/kakao-callback/",
                "response_type": "code"
              }
            },
            "2_token_exchange": {
              "url": "TOKEN_URL",
              "method": "POST",
              "params": {
                "grant_type": "authorization_code",
                "client_id": "REST API Key",
                "redirect_uri": "/kakao-callback/",
                "code": "authorization_code",
                "client_secret": "optional"
              }
            },
            "3_user_info": {
              "url": "USER_INFO_URL",
              "method": "GET",
              "headers": {
                "Authorization": "Bearer {access_token}"
              },
              "response_mapping": {
                "provider_id": "data['id']",
                "email": "data['kakao_account']['email']",
                "name": "data['properties']['nickname']",
                "profile_image": "data['properties']['profile_image']"
              }
            }
          },
          "key_methods": {
            "get_login_url": {
              "description": "Generate Kakao OAuth authorization URL",
              "returns": "string - authorization URL with query params"
            },
            "handle_callback": {
              "description": "Process Kakao callback at /kakao-callback/",
              "flow": [
                "1. Validate authorization code",
                "2. Exchange code for access token",
                "3. Fetch user info",
                "4. Process social login via WIA_Social_Auth_Handler",
                "5. Set WordPress auth cookie",
                "6. Redirect to appropriate page"
              ]
            }
          }
        },
        {
          "name": "WIA_Naver_Login",
          "file": "includes/class-naver-login.php",
          "responsibilities": [
            "Naver OAuth 2.0 flow implementation",
            "CSRF protection with state parameter",
            "Authorization code exchange",
            "User info retrieval"
          ],
          "oauth_endpoints": {
            "AUTH_URL": "https://nid.naver.com/oauth2.0/authorize",
            "TOKEN_URL": "https://nid.naver.com/oauth2.0/token",
            "USER_INFO_URL": "https://openapi.naver.com/v1/nid/me"
          },
          "security": {
            "csrf_protection": {
              "method": "State parameter with WordPress transients",
              "generation": "wp_create_nonce('wia_naver_login')",
              "storage": "set_transient('wia_naver_state_{state}', true, 600)",
              "expiration": "10 minutes"
            }
          },
          "api_flow": {
            "1_authorization": {
              "url": "AUTH_URL",
              "params": {
                "response_type": "code",
                "client_id": "Client ID",
                "redirect_uri": "/naver-callback/",
                "state": "CSRF token"
              }
            },
            "2_token_exchange": {
              "url": "TOKEN_URL",
              "method": "GET",
              "params": {
                "grant_type": "authorization_code",
                "client_id": "Client ID",
                "client_secret": "Client Secret",
                "code": "authorization_code",
                "state": "CSRF token"
              }
            },
            "3_user_info": {
              "url": "USER_INFO_URL",
              "method": "GET",
              "headers": {
                "Authorization": "Bearer {access_token}"
              },
              "response_mapping": {
                "provider_id": "data['response']['id']",
                "email": "data['response']['email']",
                "name": "data['response']['name'] || data['response']['nickname']",
                "profile_image": "data['response']['profile_image']"
              }
            }
          }
        },
        {
          "name": "WIA_Social_Admin_Settings",
          "file": "admin/admin-settings.php",
          "responsibilities": [
            "Settings page with tabs (General, Kakao, Naver)",
            "API key management",
            "Configuration options",
            "Setup guides"
          ]
        }
      ],

